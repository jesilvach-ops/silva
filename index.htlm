                    <div class="text-xs space-y-1">
                        <a href="#" class="block hover:text-gold-400">Términos y Condiciones</a>
                        <a href="#" class="block hover:text-gold-400">Política de Privacidad</a>
                    </div>
                </div>

            </div>

            <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-500">
                <p>&copy; 2026 Bufeth Jaze - Estudio de Abogados. Todos los derechos reservados.</p>
                <p class="mt-2 md:mt-0">Diseñado con excelencia jurídica & rigor institucional.</p>
            </div>
        </div>
    </footer>

    <!-- MODAL DE SERVICIOS DETALLADO -->
    <div id="service-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-navy-950/80 backdrop-blur-sm transition-opacity duration-300">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 sm:p-8 relative shadow-2xl border border-gold-500/30 transform transition-all">
            <button onclick="closeServiceModal()" class="absolute top-4 right-4 text-gray-400 hover:text-navy-900 text-2xl w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors" aria-label="Cerrar Modal">
                &times;
            </button>
            <div id="modal-content">
                <!-- Dynamically populated via JavaScript -->
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // 1. Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // 2. Services Modal Data & Functions
        const servicesData = {
            civil: {
                title: "Derecho Civil y Familia",
                icon: "fa-users-between-lines",
                desc: "Ofrecemos una atención sensible y altamente técnica para la resolución de conflictos familiares y patrimoniales.",
                bullets: [
                    "Divorcios por mutuo acuerdo y contenciosos.",
                    "Procesos de sucesión, partición de herencias y testamentos.",
                    "Régimen de visitas, tenencia y pensiones alimenticias.",
                    "Elaboración, revisión y rescisión de contratos civiles."
                ]
            },
            penal: {
                title: "Derecho Penal Especializado",
                icon: "fa-user-shield",
                desc: "Representación firme desde la etapa de investigación preliminar hasta el juicio oral.",
                bullets: [
                    "Defensa en delitos contra el patrimonio y delitos económicos.",
                    "Asistencia legal inmediata en detenciones y citaciones policiales.",
                    "Elaboración e interposición de querellas penales.",
                    "Compliance penal corporativo para prevención de riesgos."
                ]
            },
            corporativo: {
                title: "Derecho Corporativo & Mercantil",
                icon: "fa-building",
                desc: "Acompañamiento integral para empresas en crecimiento y corporaciones consolidadas.",
                bullets: [
                    "Constitución de sociedades y reformas estatutarias.",
                    "Fusiones, adquisiciones y reorganizaciones empresariales.",
                    "Negociación y redacción de contratos comerciales complejos.",
                    "Gobierno corporativo y auditoría legal preventiva."
                ]
            },
            inmobiliario: {
                title: "Derecho Inmobiliario y Bienes Raíces",
                icon: "fa-house-chimney",
                desc: "Protección jurídica en sus inversiones patrimoniales e inmobiliarias.",
                bullets: [
                    "Estudio de títulos y saneamiento de inmuebles.",
                    "Asesoría en contratos de compraventa y arrendamiento financiero.",
                    "Obtención de licencias urbanísticas y permisos de construcción.",
                    "Resolución de litigios por prescripción adquisitiva de dominio."
                ]
            },
            laboral: {
                title: "Derecho Laboral y Patronal",
                icon: "fa-briefcase",
                desc: "Garantizamos el cumplimiento normativo laboral y la defensa ante contingencias.",
                bullets: [
                    "Defensa frente a despidos arbitrarios e indemnizaciones.",
                    "Negociaciones colectivas y pactos de trabajo.",
                    "Auditorías laborales para prevención de sanciones SUNAFIL/Inspecciones.",
                    "Asesoría en contratación de personal nacional y extranjero."
                ]
            },
            tributario: {
                title: "Asesoría Tributaria y Fiscal",
                icon: "fa-file-invoice-dollar",
                desc: "Optimización fiscal legal y representación contundente ante autoridades tributarias.",
                bullets: [
                    "Planificación tributaria para personas y empresas.",
                    "Atención estratégica durante procesos de auditoría fiscal.",
                    "Reclamaciones y apelaciones ante el Tribunal Fiscal.",
                    "Asesoría en tributación internacional y convenios de doble imposición."
                ]
            }
        };

        function openServiceModal(key) {
            const data = servicesData[key];
            if(!data) return;

            const modalContent = document.getElementById('modal-content');
            modalContent.innerHTML = `
                <div class="flex items-center space-x-4 mb-4">
                    <div class="w-12 h-12 rounded-xl bg-navy-900 text-gold-400 flex items-center justify-center text-xl shrink-0">
                        <i class="fas ${data.icon}"></i>
                    </div>
                    <div>
                        <h3 class="text-2xl font-serif font-bold text-navy-900">${data.title}</h3>
                        <p class="text-xs text-gold-600 font-semibold uppercase">Bufeth Jaze Especialidad</p>
                    </div>
                </div>
                <p class="text-gray-600 text-sm leading-relaxed mb-6">${data.desc}</p>
                <div class="bg-champagne/60 p-4 rounded-xl border border-gold-500/20 mb-6">
                    <h4 class="font-bold text-navy-900 text-sm mb-3">Servicios clave incluidos:</h4>
                    <ul class="space-y-2 text-xs text-gray-700">
                        ${data.bullets.map(b => `<li class="flex items-center"><i class="fas fa-check text-gold-500 mr-2"></i> ${b}</li>`).join('')}
                    </ul>
                </div>
                <div class="flex justify-end space-x-3">
                    <button onclick="closeServiceModal()" class="px-5 py-2.5 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 text-sm font-semibold">Cerrar</button>
                    <a href="#contacto" onclick="closeServiceModal()" class="px-5 py-2.5 rounded-lg bg-gold-500 text-navy-950 hover:bg-gold-400 text-sm font-bold flex items-center space-x-2">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Solicitar Cita de esta Área</span>
                    </a>
                </div>
            `;

            document.getElementById('service-modal').classList.remove('hidden');
        }

        function closeServiceModal() {
            document.getElementById('service-modal').classList.add('hidden');
        }

        // Close Modal on backdrop click
        document.getElementById('service-modal').addEventListener('click', (e) => {
            if(e.target === document.getElementById('service-modal')) {
                closeServiceModal();
            }
        });

        // 3. Counter Animation for Statistics Section
        let countersAnimated = false;
        function animateCounters() {
            const statsSection = document.getElementById('estadisticas');
            const rect = statsSection.getBoundingClientRect();
            
            if(rect.top <= window.innerHeight && !countersAnimated) {
                countersAnimated = true;
                const counters = statsSection.querySelectorAll('[data-target]');
                
                counters.forEach(counter => {
                    const target = +counter.getAttribute('data-target');
                    const duration = 1500;
                    const stepTime = 30;
                    const steps = duration / stepTime;
                    const increment = target / steps;
                    let current = 0;

                    const timer = setInterval(() => {
                        current += increment;
                        if (current >= target) {
                            current = target;
                            clearInterval(timer);
                        }
                        
                        if(target === 98) {
                            counter.innerText = Math.ceil(current) + '%';
                        } else if(target >= 100) {
                            counter.innerText = '+' + Math.ceil(current);
                        } else {
                            counter.innerText = '+' + Math.ceil(current);
                        }
                    }, stepTime);
                });
            }
        }
        window.addEventListener('scroll', animateCounters);

        // 4. Testimonials Slider
        let currentSlide = 0;
        const track = document.getElementById('testimonial-track');
        const dots = document.querySelectorAll('#testimonial-dots button');
        const totalSlides = 3;

        function updateSlider() {
            track.style.transform = `translateX(-${currentSlide * 100}%)`;
            dots.forEach((dot, idx) => {
                if(idx === currentSlide) {
                    dot.classList.remove('bg-gray-300');
                    dot.classList.add('bg-gold-500');
                } else {
                    dot.classList.remove('bg-gold-500');
                    dot.classList.add('bg-gray-300');
                }
            });
        }

        function goToSlide(index) {
            currentSlide = index;
            updateSlider();
        }

        document.getElementById('next-testimonial').addEventListener('click', () => {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateSlider();
        });

        document.getElementById('prev-testimonial').addEventListener('click', () => {
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateSlider();
        });

        // 5. FAQ Accordion Toggle
        function toggleFaq(button) {
            const content = button.nextElementSibling;
            const icon = button.querySelector('i');

            if(content.classList.contains('hidden')) {
                // Close other opened FAQs
                document.querySelectorAll('#faq-accordion > div').forEach(item => {
                    item.querySelector('div').classList.add('hidden');
                    item.querySelector('i').classList.remove('rotate-180');
                });

                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        }

        // 6. Form Submission & Toast Notification
        function handleFormSubmit(e) {
            e.preventDefault();
            
            const name = document.getElementById('nombre').value;
            showToast("¡Solicitud Recibida!", `Gracias ${name}, un abogado especialista evaluará su caso.`);
            
            // Reset form
            document.getElementById('consultation-form').reset();
        }

        function showToast(title, message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-message').innerText = message;

            toast.classList.remove('translate-y-32', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-32', 'opacity-0');
            }, 4500);
        }
    </script>
</body>
</html>
