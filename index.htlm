                <!-- Interactive Form Column -->
                <div class="lg:col-span-7 bg-white text-gray-800 p-8 sm:p-10 rounded-2xl shadow-2xl border border-gold-500/20">
                    <h3 class="text-2xl font-serif font-bold text-navy-900 mb-6">Formulario de Reserva de Cita</h3>
                    
                    <form id="consultation-form" onsubmit="handleFormSubmit(event)" class="space-y-5">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2" for="nombre">Nombre Completo *</label>
                                <input type="text" id="nombre" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 focus:border-gold-500 outline-none transition-all text-sm" placeholder="Ej: Roberto Gómez">
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2" for="email">Correo Electrónico *</label>
                                <input type="email" id="email" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 focus:border-gold-500 outline-none transition-all text-sm" placeholder="ejemplo@correo.com">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2" for="telefono">Teléfono / WhatsApp *</label>
                                <input type="tel" id="telefono" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 focus:border-gold-500 outline-none transition-all text-sm" placeholder="+51 900 000 000">
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2" for="tipo-caso">Tipo de Caso *</label>
                                <select id="tipo-caso" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 focus:border-gold-500 outline-none transition-all text-sm bg-white">
                                    <option value="">Seleccione una especialidad</option>
                                    <option value="civil">Derecho Civil y Familia</option>
                                    <option value="penal">Derecho Penal</option>
                                    <option value="corporativo">Derecho Corporativo / Mercantil</option>
                                    <option value="inmobiliario">Derecho Inmobiliario</option>
                                    <option value="laboral">Derecho Laboral</option>
                                    <option value="tributario">Asesoría Tributaria y Fiscal</option>
                                    <option value="otro">Otro tipo de consulta</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2" for="fecha">Fecha Preferida</label>
                                <input type="date" id="fecha" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 focus:border-gold-500 outline-none transition-all text-sm">
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2" for="hora">Hora Preferida</label>
                                <select id="hora" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 focus:border-gold-500 outline-none transition-all text-sm bg-white">
                                    <option value="mañana">Mañana (09:00 AM - 12:00 PM)</option>
                                    <option value="tarde">Tarde (02:00 PM - 06:00 PM)</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2" for="mensaje">Breve resumen de su situación legal</label>
                            <textarea id="mensaje" rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 focus:border-gold-500 outline-none transition-all text-sm" placeholder="Describa brevemente los hechos principales para poder asignarle al especialista adecuado..."></textarea>
                        </div>

                        <div class="flex items-center space-x-2">
                            <input type="checkbox" id="politica" required class="rounded border-gray-300 text-gold-600 focus:ring-gold-500 h-4 w-4">
                            <label for="politica" class="text-xs text-gray-600">
                                Acepto la política de privacidad y el tratamiento confidencial de mis datos.
                            </label>
                        </div>

                        <button type="submit" class="w-full bg-gradient-to-r from-navy-900 to-navy-800 hover:from-gold-500 hover:to-gold-600 hover:text-navy-950 text-white font-bold py-4 rounded-xl shadow-lg transition-all duration-300 text-base flex items-center justify-center space-x-2">
                            <i class="fas fa-paper-plane"></i>
                            <span>Solicitar Consulta Legal Gratuita</span>
                        </button>
                    </form>
                </div>

            </div>
        </div>
