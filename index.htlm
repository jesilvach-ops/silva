<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bufeth Jaze | Estudio de Abogados & Asesoría Legal Especializada</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            800: '#0a192f',
                            900: '#071120',
                            950: '#030811',
                        },
                        gold: {
                            400: '#e5c158',
                            500: '#d4af37',
                            600: '#aa8c2c',
                        },
                        champagne: '#f7f4eb',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'Georgia', 'serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3, .font-serif { font-family: 'Playfair Display', serif; }
        
        /* Gradient custom classes */
        .bg-navy-gradient {
            background: linear-gradient(135deg, #071120 0%, #0a192f 50%, #112240 100%);
        }
        .text-gold-gradient {
            background: linear-gradient(135deg, #f3e5ab 0%, #d4af37 50%, #aa8c2c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .border-gold-gradient {
            border-image: linear-gradient(to right, #d4af37, #f3e5ab) 1;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 antialiased selection:bg-gold-500 selection:text-white">

    <!-- TOAST NOTIFICATION -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-32 opacity-0 transition-all duration-500 ease-in-out bg-navy-900 text-white px-6 py-4 rounded-xl shadow-2xl border-l-4 border-gold-500 flex items-center space-x-4 max-w-md pointer-events-none">
        <div class="text-gold-500 text-2xl">
            <i class="fas fa-check-circle"></i>
        </div>
        <div>
            <h4 class="font-bold text-sm text-gold-400" id="toast-title">¡Solicitud Enviada!</h4>
            <p class="text-xs text-gray-300" id="toast-message">Nos pondremos en contacto contigo en breve.</p>
        </div>
    </div>

    <!-- HEADER / NAVEGACIÓN -->
    <header class="sticky top-0 z-40 bg-navy-900/95 backdrop-blur-md border-b border-gold-500/20 text-white transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <a href="#" class="flex items-center space-x-3 group">
                    <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-gold-400 to-gold-600 flex items-center justify-center text-navy-900 font-bold text-xl shadow-lg group-hover:scale-105 transition-transform">
                        <i class="fas fa-balance-scale"></i>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-serif text-2xl font-bold tracking-wider text-white group-hover:text-gold-400 transition-colors">BUFETH JAZE</span>
                        <span class="text-[10px] tracking-widest uppercase text-gold-400 font-semibold">Estudio Jurídico</span>
                    </div>
                </a>

                <!-- Desktop Navigation -->
                <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
                    <a href="#inicio" class="text-white hover:text-gold-400 transition-colors">Inicio</a>
                    <a href="#nosotros" class="text-gray-300 hover:text-gold-400 transition-colors">Nosotros</a>
                    <a href="#servicios" class="text-gray-300 hover:text-gold-400 transition-colors">Servicios</a>
                    <a href="#estadisticas" class="text-gray-300 hover:text-gold-400 transition-colors">Por Qué Elegirnos</a>
                    <a href="#testimonios" class="text-gray-300 hover:text-gold-400 transition-colors">Testimonios</a>
                    <a href="#faq" class="text-gray-300 hover:text-gold-400 transition-colors">FAQ</a>
                </nav>

                <!-- CTA Button Desktop -->
                <div class="hidden md:block">
                    <a href="#contacto" class="bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-400 hover:to-gold-500 text-navy-950 font-semibold px-5 py-2.5 rounded-lg shadow-md hover:shadow-gold-500/20 transition-all duration-300 text-sm flex items-center space-x-2">
                        <i class="fas fa-calendar-check"></i>
                        <span>Consulta Gratuita</span>
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" class="text-gray-300 hover:text-white focus:outline-none p-2" aria-label="Abrir Menú">
                        <i class="fas fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Drawer -->
        <div id="mobile-menu" class="hidden md:hidden bg-navy-950 border-b border-gold-500/20 px-4 pt-2 pb-6 space-y-3">
            <a href="#inicio" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-white hover:bg-navy-800">Inicio</a>
            <a href="#nosotros" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:bg-navy-800">Nosotros</a>
            <a href="#servicios" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:bg-navy-800">Servicios</a>
            <a href="#estadisticas" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:bg-navy-800">Por Qué Elegirnos</a>
            <a href="#testimonios" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:bg-navy-800">Testimonios</a>
            <a href="#faq" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:bg-navy-800">FAQ</a>
            <a href="#contacto" class="mobile-link block w-full text-center bg-gold-500 text-navy-950 font-bold px-4 py-3 rounded-lg mt-4">
                Solicitar Consulta Gratuita
            </a>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section id="inicio" class="relative bg-navy-gradient text-white overflow-hidden py-20 lg:py-32">
        <!-- Background Overlay Elements -->
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#d4af37_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
                    <div class="inline-flex items-center space-x-2 bg-navy-800/80 border border-gold-500/30 px-4 py-2 rounded-full text-xs font-semibold text-gold-400">
                        <span class="flex h-2 w-2 rounded-full bg-gold-400 animate-pulse"></span>
                        <span class="tracking-wider uppercase">Excelencia & Liderazgo Jurídico</span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold leading-tight">
                        Defendemos tus derechos con <span class="text-gold-gradient">excelencia</span> y compromiso legal.
                    </h1>

                    <p class="text-lg text-gray-300 max-w-2xl mx-auto lg:mx-0 font-light leading-relaxed">
                        En Bufeth Jaze combinamos décadas de experiencia rigurosa con una visión moderna para brindar soluciones jurídicas eficaces, estratégicas y altamente personalizadas.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                        <a href="#contacto" class="w-full sm:w-auto bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-400 hover:to-gold-500 text-navy-950 font-bold px-8 py-4 rounded-xl shadow-lg hover:shadow-gold-500/20 transform hover:-translate-y-0.5 transition-all text-center">
                            Solicitar Consulta Gratuita
                        </a>
                        <a href="#servicios" class="w-full sm:w-auto border border-gray-600 hover:border-gold-400 text-gray-200 hover:text-gold-400 font-semibold px-8 py-4 rounded-xl transition-all text-center bg-navy-900/40 backdrop-blur-sm">
                            Conocer Servicios
                        </a>
                    </div>

                    <!-- Trust Badge & Quick Stats -->
                    <div class="pt-6 border-t border-gray-800/80 grid grid-cols-3 gap-4 text-center lg:text-left">
                        <div>
                            <p class="text-2xl lg:text-3xl font-bold font-serif text-gold-400">+15</p>
                            <p class="text-xs text-gray-400 uppercase tracking-wider">Años de Exp.</p>
                        </div>
                        <div>
                            <p class="text-2xl lg:text-3xl font-bold font-serif text-gold-400">98%</p>
                            <p class="text-xs text-gray-400 uppercase tracking-wider">Éxito Comprobado</p>
                        </div>
                        <div>
                            <p class="text-2xl lg:text-3xl font-bold font-serif text-gold-400">24/7</p>
                            <p class="text-xs text-gray-400 uppercase tracking-wider">Atención Prioritaria</p>
                        </div>
                    </div>
                </div>

                <!-- Hero Image Card -->
                <div class="lg:col-span-5 relative">
                    <div class="relative mx-auto max-w-md lg:max-w-none">
                        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-gold-500 to-blue-600 opacity-30 blur-lg"></div>
                        <div class="relative bg-navy-800 rounded-2xl overflow-hidden border border-gold-500/30 shadow-2xl">
                            <img src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=800&q=80" 
                                 alt="Despacho Jurídico Bufeth Jaze" 
                                 class="w-full h-80 object-cover object-center"
                                 onerror="this.onerror=null; this.src='https://placehold.co/800x500/0a192f/d4af37?text=Bufeth+Jaze+Abogados';">
                            <div class="p-6 bg-navy-900/90 backdrop-blur-md">
                                <div class="flex items-center space-x-4 mb-3">
                                    <div class="w-12 h-12 rounded-full bg-gold-500/20 text-gold-400 flex items-center justify-center text-xl">
                                        <i class="fas fa-gavel"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-serif font-bold text-lg text-white">Compromiso Legal Ético</h3>
                                        <p class="text-xs text-gray-400">Respaldo total en cada etapa de su proceso.</p>
                                    </div>
                                </div>
                                <p class="text-sm text-gray-300 italic">"La justicia no es un ideal lejano, es la meta diaria de nuestro trabajo diario."</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SOBRE NOSOTROS -->
    <section id="nosotros" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <!-- Left Image Showcase -->
                <div class="lg:col-span-5 relative">
                    <div class="relative rounded-2xl overflow-hidden shadow-2xl border-b-4 border-gold-500">
                        <img src="https://images.unsplash.com/photo-1521791136364-7236974b4238?auto=format&fit=crop&w=800&q=80" 
                             alt="Equipo de Bufeth Jaze" 
                             class="w-full h-auto object-cover"
                             onerror="this.onerror=null; this.src='https://placehold.co/800x900/071120/ffffff?text=Equipo+Bufeth+Jaze';">
                        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-navy-950/90 to-transparent p-6 text-white">
                            <p class="font-serif font-bold text-lg">Socios Fundadores</p>
                            <p class="text-xs text-gold-400">Líderes en litigios estratégicos y asesoría jurídica corporativa</p>
                        </div>
                    </div>
                </div>

                <!-- Right Text Content -->
                <div class="lg:col-span-7 space-y-6">
                    <div>
                        <span class="text-gold-600 font-bold text-sm tracking-widest uppercase">Sobre Nuestro Bufete</span>
                        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-navy-900 mt-2">
                            Una sólida trayectoria respaldando la tranquilidad de nuestros clientes.
                        </h2>
                    </div>

                    <p class="text-gray-600 leading-relaxed">
                        Fundado con la premisa de entregar una representación legal rigurosa, transparente y de vanguardia, <strong>Bufeth Jaze</strong> se ha posicionado como uno de los bufetes de referencia en el país. Entendemos que detrás de cada caso hay intereses personales o corporativos de vital importancia.
                    </p>

                    <p class="text-gray-600 leading-relaxed">
                        Nuestro enfoque integra la atención personalizada de un socio directo con la capacidad de resolución de un equipo multidisciplinario altamente calificado.
                    </p>

                    <!-- Core Values Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4">
                        <div class="p-4 rounded-xl bg-champagne/60 border border-gold-500/20">
                            <div class="w-10 h-10 rounded-lg bg-navy-900 text-gold-400 flex items-center justify-center mb-3">
                                <i class="fas fa-shield-halved"></i>
                            </div>
                            <h3 class="font-bold text-navy-900 text-base mb-1">Integridad</h3>
                            <p class="text-xs text-gray-600">Transparencia absoluta en diagnósticos u honorarios.</p>
                        </div>

                        <div class="p-4 rounded-xl bg-champagne/60 border border-gold-500/20">
                            <div class="w-10 h-10 rounded-lg bg-navy-900 text-gold-400 flex items-center justify-center mb-3">
                                <i class="fas fa-award"></i>
                            </div>
                            <h3 class="font-bold text-navy-900 text-base mb-1">Excelencia</h3>
                            <p class="text-xs text-gray-600">Estrategias procesales minuciosas y rigurosas.</p>
                        </div>

                        <div class="p-4 rounded-xl bg-champagne/60 border border-gold-500/20">
                            <div class="w-10 h-10 rounded-lg bg-navy-900 text-gold-400 flex items-center justify-center mb-3">
                                <i class="fas fa-handshake"></i>
                            </div>
                            <h3 class="font-bold text-navy-900 text-base mb-1">Compromiso</h3>
                            <p class="text-xs text-gray-600">Dedicación plena a la defensa de tus metas.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SERVICIOS LEGALES -->
    <section id="servicios" class="py-20 bg-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-gold-600 font-bold text-sm tracking-widest uppercase">Áreas de Práctica</span>
                <h2 class="text-3xl sm:text-4xl font-serif font-bold text-navy-900 mt-2">
                    Soluciones legales especializadas para cada necesidad
                </h2>
                <p class="text-gray-600 mt-4 text-sm sm:text-base">
                    Ofrecemos cobertura legal integral adaptada tanto a personas naturales como a corporaciones exigentes.
                </p>
            </div>

            <!-- Services Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                
                <!-- Service 1 -->
                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-200 hover:border-gold-500/50 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-navy-900 text-gold-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-gold-500 group-hover:text-navy-950 transition-all">
                            <i class="fas fa-users-between-lines"></i>
                        </div>
                        <h3 class="text-xl font-serif font-bold text-navy-900 mb-3">Derecho Civil y Familia</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-6">
                            Gestión integral de divorcios, sucesiones, acuerdos prematrimoniales, herencias y resolución de conflictos contractuales.
                        </p>
                    </div>
                    <button onclick="openServiceModal('civil')" class="inline-flex items-center text-sm font-bold text-gold-600 hover:text-gold-500 transition-colors">
                        <span>Saber más detalles</span>
                        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>

                <!-- Service 2 -->
                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-200 hover:border-gold-500/50 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-navy-900 text-gold-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-gold-500 group-hover:text-navy-950 transition-all">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        <h3 class="text-xl font-serif font-bold text-navy-900 mb-3">Derecho Penal</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-6">
                            Defensa especializada en procesos penales, querellas, delitos económicos, asistencia en detenciones y juicios orales.
                        </p>
                    </div>
                    <button onclick="openServiceModal('penal')" class="inline-flex items-center text-sm font-bold text-gold-600 hover:text-gold-500 transition-colors">
                        <span>Saber más detalles</span>
                        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>

                <!-- Service 3 -->
                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-200 hover:border-gold-500/50 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-navy-900 text-gold-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-gold-500 group-hover:text-navy-950 transition-all">
                            <i class="fas fa-building"></i>
                        </div>
                        <h3 class="text-xl font-serif font-bold text-navy-900 mb-3">Derecho Corporativo</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-6">
                            Asesoría empresarial preventiva, fusiones y adquisiciones, estructuración de sociedades y compliance regulatorio.
                        </p>
                    </div>
                    <button onclick="openServiceModal('corporativo')" class="inline-flex items-center text-sm font-bold text-gold-600 hover:text-gold-500 transition-colors">
                        <span>Saber más detalles</span>
                        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>

                <!-- Service 4 -->
                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-200 hover:border-gold-500/50 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-navy-900 text-gold-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-gold-500 group-hover:text-navy-950 transition-all">
                            <i class="fas fa-house-chimney"></i>
                        </div>
                        <h3 class="text-xl font-serif font-bold text-navy-900 mb-3">Derecho Inmobiliario</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-6">
                            Saneamiento de predios, auditoría de títulos, contratos de compraventa, arrendamientos complejos y licencias.
                        </p>
                    </div>
                    <button onclick="openServiceModal('inmobiliario')" class="inline-flex items-center text-sm font-bold text-gold-600 hover:text-gold-500 transition-colors">
                        <span>Saber más detalles</span>
                        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>

                <!-- Service 5 -->
                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-200 hover:border-gold-500/50 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-navy-900 text-gold-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-gold-500 group-hover:text-navy-950 transition-all">
                            <i class="fas fa-briefcase"></i>
                        </div>
                        <h3 class="text-xl font-serif font-bold text-navy-900 mb-3">Derecho Laboral</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-6">
                            Representación en despidos intempestivos, indemnizaciones, negociaciones colectivas e inspecciones del trabajo.
                        </p>
                    </div>
                    <button onclick="openServiceModal('laboral')" class="inline-flex items-center text-sm font-bold text-gold-600 hover:text-gold-500 transition-colors">
                        <span>Saber más detalles</span>
                        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>

                <!-- Service 6 -->
                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-200 hover:border-gold-500/50 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-navy-900 text-gold-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 group-hover:bg-gold-500 group-hover:text-navy-950 transition-all">
                            <i class="fas fa-file-invoice-dollar"></i>
                        </div>
                        <h3 class="text-xl font-serif font-bold text-navy-900 mb-3">Asesoría Tributaria y Fiscal</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-6">
                            Planificación fiscal eficiente, atención a auditorías tributarias, reclamos administrativos y litigios fiscales.
                        </p>
                    </div>
                    <button onclick="openServiceModal('tributario')" class="inline-flex items-center text-sm font-bold text-gold-600 hover:text-gold-500 transition-colors">
                        <span>Saber más detalles</span>
                        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>

            </div>
        </div>
    </section>

    <!-- ESTADÍSTICAS / POR QUÉ ELEGIRNOS -->
    <section id="estadisticas" class="py-20 bg-navy-gradient text-white relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-gold-400 font-bold text-sm tracking-widest uppercase">Resultados Tangibles</span>
                <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white mt-2">
                    Cifras que demuestran nuestra dedicación
                </h2>
                <p class="text-gray-300 mt-4 text-sm sm:text-base">
                    Trabajamos bajo los más altos estándares de rigor legal para maximizar las probabilidades de éxito en cada proceso.
                </p>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Stat 1 -->
                <div class="bg-navy-800/60 border border-gold-500/20 p-8 rounded-2xl text-center backdrop-blur-sm">
