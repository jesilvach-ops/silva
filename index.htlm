                            </div>
                        </div>

                        <div class="flex items-start space-x-4">
                            <div class="w-10 h-10 rounded-lg bg-navy-800 border border-gold-500/30 text-gold-400 flex items-center justify-center shrink-0">
                                <i class="fas fa-phone"></i>
                            </div>
